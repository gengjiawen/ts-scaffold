{
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node",
      "jest"
    ],
    "lib": [
      "es2020",
      "dom"
    ]
  },
  "include": [
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "sample_out"
  ]
}
