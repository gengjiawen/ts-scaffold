{
  "name": "<%= name %>",
  "version": "0.0.1",
  "description": "<%= description %>",
  "repository": {
    "url": "<%= username %>/<%= name %>",
    "type": "git"
  },
  "main": "build/index.js",
  "license": "MIT",
  "author": "<%= username %> <<%= email %>>",
  "scripts": {
    "start": "tsc -w",
    "server": "tsx watch libs/index.ts",
    "prepare": "husky install",
    "clean": "rimraf build",
    "format": "prettier --write \"{examples,libs,script,bin}/**/*.{js,ts}\" \"**/*.yml\"",
    "format:check": "prettier --list-different \"{examples,libs,script,bin}/**/*.{js,ts}\" \"**/*.yml\"",
    "test": "jest",
    "typecheck": "tsc -p ./tsconfig.test.json",
    "build": "npm run clean && tsc -p ./tsconfig.json",
    "postbuild": "cpy \"**/*\" \"!**/*.ts\" ../build/ --cwd=libs || exit 0"
  },
  "dependencies": {
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/node": "26.1.0",
    "@types/jest": "30.0.0",
    "cpy-cli": "^7.0.0",
    "husky": "9.1.7",
    "lint-staged": "^17.0.8",
    "rimraf": "6.1.3",
    "jest": "30.5.1",
    "tsx": "^4.23.13",
    "prettier": "3.5.3",
    "typescript": "7.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,md,css,html,yml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2020",
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            }
          }
        }
      ]
    }
  }
}
